# Scraper Moodle → Backend (ingest por HTTP)
# Copiar a .env y rellenar. La imagen se ejecuta de forma independiente con estas variables.

# Credenciales Moodle (del sitio que se va a scrapear)
MOODLE_BASE_URL=https://moodle.ejemplo.edu
MOODLE_USERNAME=tu_usuario
MOODLE_PASSWORD=tu_password

# Usuario en el backend remoto (ID numérico)
USER_ID=1

# URL base del API del backend (sin barra final). El script llama a {INGEST_URL}/api/v1/moodle/ingest
INGEST_URL=https://api.tudominio.com

# API key de ingest (generada en el backend con POST /api/v1/moodle/ingest-key, con JWT)
# Se puede usar API_KEY o INGEST_API_KEY
INGEST_API_KEY=
# API_KEY=

# Opcional: persistir snapshot entre ejecuciones (montar volumen en el contenedor en esta ruta)
# SNAPSHOT_DATA_DIR=/data
